# OpenAI API (para o agente RAG e embeddings)
OPENAI_API_KEY=sk-...

# Supabase (Banco de dados de usuários)
# Pegue em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANTE: Use a service_role key (secret) no backend, NÃO a anon public key
SUPABASE_SERVICE_ROLE_KEY=ey...

# JWT Token Secret (gere uma string aleatória segura para produção)
JWT_SECRET=renvest-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth (opcional para validação de audiência)
GOOGLE_CLIENT_ID=

# CORS - Origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
