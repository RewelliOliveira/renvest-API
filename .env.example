# OpenAI API (para o agente RAG e embeddings)
OPENAI_API_KEY=sk-...
# Modelo de chat e temperatura (opcionais)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# Supabase (Banco de dados de usuários)
# Pegue em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANTE: Use a service_role key (secret) no backend, NÃO a anon public key
SUPABASE_SERVICE_ROLE_KEY=ey...

# JWT Token Secret (OBRIGATÓRIO, mínimo 32 caracteres - a API não inicia sem ele)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Token das rotas administrativas (header X-Admin-Token). Vazio = rotas desativadas.
ADMIN_TOKEN=

# Google OAuth Client ID (OBRIGATÓRIO para o login com Google: valida a audiência dos tokens)
# Deve ser o mesmo valor de VITE_GOOGLE_CLIENT_ID do frontend
GOOGLE_CLIENT_ID=

# Rate limiting (requisições por minuto)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=15

# CORS - Origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
